{
  "name": "power-dsh",
  "version": "0.0.1",
  "private": true,
  "description": "A DeepSeek Harness (DSH) enhancement plugin. Minimal, elegant, yet deeply powerful. Making your DSH effortless and efficient.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "mcp",
    "notifications",
    "skill-management",
    "customization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mewcoder/power-dsh.git"
  },
  "homepage": "https://github.com/mewcoder/power-dsh#readme",
  "bugs": {
    "url": "https://github.com/mewcoder/power-dsh/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./assets/locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "src/*.js",
    "assets/icon.svg",
    "assets/locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/third-party-notices.md",
    "docs/images/0.0.1/settings.webp",
    "screenshots.json"
  ],
  "scripts": {
    "check": "node scripts/check.mjs && node --test tests/*.test.mjs",
    "check:compat": "node scripts/check-compatibility.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
