{
  "name": "power-dsh",
  "version": "0.0.6",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "description": "A DeepSeek Harness (DSH) enhancement plugin. Minimal, elegant, yet deeply powerful. Making your DSH effortless and efficient.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "mcp",
    "notifications",
    "skill-management",
    "customization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mewcoder/power-dsh.git"
  },
  "homepage": "https://github.com/mewcoder/power-dsh#readme",
  "bugs": {
    "url": "https://github.com/mewcoder/power-dsh/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./assets/locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "src/features/*/spec.md",
    "assets/icon.svg",
    "assets/locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/third-party-notices.md",
    "docs/images/0.0.1/settings.webp",
    "screenshots.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build.mjs --client",
    "check:build": "node scripts/build.mjs --check",
    "check:types": "tsc --noEmit",
    "check": "npm run check:types && node scripts/check.mjs && node scripts/test.mjs",
    "check:compat": "node scripts/check-compatibility.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:install": "node scripts/check-install.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0 || >=0.2.2-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0 || >=0.2.2-alpha.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "tsdown": "0.23.7",
    "typescript": "5.9.3"
  }
}
